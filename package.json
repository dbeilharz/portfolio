{
  "name": "portfolio",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prettier": "pnpm exec prettier ./src --write",
    "ts": "./node_modules/typescript/bin/tsc -b --noEmit --incremental",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "all": "pnpm run lint && pnpm run ts",
    "e2e": "NODE_OPTIONS=\"--no-warnings\" pnpm exec playwright test --project chromium",
    "e2e:firefox": "NODE_OPTIONS=\"--no-warnings\" pnpm exec playwright test --project firefox",
    "e2e:webkit": "NODE_OPTIONS=\"--no-warnings\" pnpm exec playwright test --project webkit",
    "e2e:ui": "NODE_OPTIONS=\"--no-warnings\" pnpm exec playwright test --ui"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-dom": "^5.24.10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.24.10",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
